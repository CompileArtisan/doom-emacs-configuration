\tcbuselibrary{listings,skins,breakable}
\usepackage{listings}
\usepackage{etoolbox}
\usepackage{mathtools,amsthm,amssymb,amsfonts,bm}
\usepackage{thmtools,amsmath}
\usepackage{marginnote,sidenotes}
